{
  "name": "ai-novelist-studio",
  "productName": "AI Novelist Studio",
  "version": "1.4.17",
  "description": "AIのべりすと API を使った小説執筆・チャットツール",
  "main": "main.js",
  "scripts": {
    "start": "node \"%INIT_CWD%\\server.js\"",
    "dev": "node --watch \"%INIT_CWD%\\server.js\"",
    "desktop": "electron \"%INIT_CWD%\"",
    "icon": "node \"%INIT_CWD%\\scripts\\make-icon.js\"",
    "setup:readability": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%INIT_CWD%\\scripts\\setup-readability.ps1\"",
    "build:editor": "node \"%INIT_CWD%\\scripts\\build-editor.js\"",
    "dist": "pushd \"%INIT_CWD%\" && node node_modules\\electron-builder\\cli.js --win"
  },
  "build": {
    "appId": "com.ainoveliststudio.app",
    "productName": "AI Novelist Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "public/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/",
        "to": "tools/",
        "filter": [
          "mecab-dist/**",
          "unidic-mecab/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "chart.js": "^4.6.1",
    "diff": "^9.0.0",
    "express": "^5.3.0",
    "fuse.js": "^7.5.0",
    "jreadability": "^1.0.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5"
  }
}
